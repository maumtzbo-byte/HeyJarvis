# --- Supabase (usuarios y registro estructurado de recuerdos) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Anthropic / Claude (resumen de recuerdos y generación de respuestas) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# --- ChromaDB (memoria vectorial local, persistida en disco) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- Auth simple del MVP ---
# Si se deja vacío, /memory, /query y /memories/{user_id} no exigen header.
# Si se define, hay que enviar el mismo valor en el header X-API-Key.
APP_API_KEY=

# --- CORS ---
# Orígenes permitidos para llamar a la API desde el navegador (ej. el
# dashboard web), separados por coma. "*" permite cualquiera (default, ok
# para desarrollo). En producción, restringir a la URL real del dashboard.
ALLOWED_ORIGINS=*
