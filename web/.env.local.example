# Public URL of the HeyYarvis backend (FastAPI).
# Local development, with the backend running on your machine:
NEXT_PUBLIC_API_URL=http://localhost:8000

# In production, point this at the deployed backend (Render/Railway/Fly.io).

# Supabase project used for real accounts (sign up / log in) and onboarding
# preferences. Safe to expose publicly: this is the anon key, not the
# service role key — Row Level Security restricts it to each user's own row.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
